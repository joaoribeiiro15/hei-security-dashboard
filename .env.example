# =============================================================================
# HEI Security Dashboard - Environment Configuration (template)
# =============================================================================
# Copy this file to `.env` and set your own values before starting the stack.
# `.env` is git-ignored and must never be committed with real credentials.

# MySQL root password (used internally by the db container)
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Application database credentials
MYSQL_DATABASE=hei_dashboard
MYSQL_USER=hei_app
MYSQL_PASSWORD=CHANGE_ME

# Set to 1 to enable bcrypt password verification (requires bcrypt in requirements.txt)
# Set to 0 to use plain-text password comparison (development only)
USE_BCRYPT=1

# Session duration in seconds (default: 8 hours)
SESSION_SECONDS=28800

# Shared secret used to sign session tokens.
# Must match TOY_SECRET in html/js/auth.js. Generate a random value per deployment.
TOY_SECRET=CHANGE_ME
