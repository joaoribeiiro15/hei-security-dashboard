# =============================================================================
# HEI Security Dashboard — Environment Configuration
# =============================================================================
# Copy this file to .env and set real values before starting the stack.
# Never commit .env to version control.

# MySQL root password (used internally by the db container)
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Application database credentials
MYSQL_DATABASE=hei_dashboard
MYSQL_USER=hei_app
MYSQL_PASSWORD=CHANGE_ME

# Set to 1 to enable bcrypt password verification (recommended, default)
# Set to 0 only for local development with plain-text passwords
USE_BCRYPT=1

# JWT session duration in seconds (default: 8 hours)
SESSION_SECONDS=28800

# Shared secret used to sign session tokens. Generate a random value, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The same value must be set in html/js/auth.js (constant TOY_SECRET).
TOY_SECRET=CHANGE_ME
