# Environment and secrets — never commit
.env
.env.local
*.pem
*.key
certs/

# Scanner data — never commit raw data or results
data/*
!data/.gitkeep
cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local tooling / assistant scratch files
.*-local/
*.local.md
